# Copy this file to .env and fill in your values.
# .env is ignored by git, so your keys never end up on GitHub.
# Restart the server after changing this file.

APP_NAME="ChatBox API"
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:4200"]

# --- Gemini (Google) ---------------------------------------------------
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Gemini model id works, e.g. gemini-flash-latest, gemini-3.8-flash
GEMINI_MODEL=gemini-flash-latest

# --- Claude (Anthropic) ------------------------------------------------
# Key: https://platform.claude.com
ANTHROPIC_API_KEY=
# Any Claude model id works, e.g. claude-opus-5-5, claude-sonnet-5-5, claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5
