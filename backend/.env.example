# Copy this file to .env and fill in your values.
# .env is ignored by git, so your keys never end up on GitHub.
# Restart the server after changing this file.

APP_NAME="ChatBox API"
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:4200"]

# --- Groq (free plan available) ------------------------------------------
# Key: https://console.groq.com/keys
GROQ_API_KEY=
# Any Groq model id works, e.g. openai/gpt-oss-120b, openai/gpt-oss-20b, llama-3.3-70b-versatile
GROQ_MODEL=openai/gpt-oss-120b

# --- Claude (Anthropic) ------------------------------------------------
# Key: https://platform.claude.com
ANTHROPIC_API_KEY=
# Any Claude model id works, e.g. claude-opus-5-5, claude-sonnet-5-5, claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5
